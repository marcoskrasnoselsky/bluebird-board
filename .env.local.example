# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Only needed for follow-up reminder emails (app/api/reminders) ---

# Supabase dashboard -> Project Settings -> API Keys -> "service_role" (Legacy API Keys tab).
# Server-only, bypasses RLS. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# resend.com -> API Keys. Free tier is enough for a small team.
RESEND_API_KEY=your-resend-api-key

# Any random string — Vercel Cron sends it as a Bearer token so the reminders
# endpoint can't be triggered by anyone else. Generate one with e.g. `openssl rand -hex 32`.
CRON_SECRET=a-random-secret-you-make-up

# The live URL of the app, used to build links in the reminder emails.
NEXT_PUBLIC_SITE_URL=https://bluebird-board.vercel.app
